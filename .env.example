# Server only. Copy to .env.local and set your key locally. Never use NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional; defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# OpenAI takes priority for event styling when configured.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
